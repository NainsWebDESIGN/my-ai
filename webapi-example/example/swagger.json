{
  "openapi": "3.0.1",
  "info": {
    "title": "Example API",
    "version": "1.0",
    "description": "💡 範例說明：這是一份簡單的 OpenAPI (Swagger) 格式範例，供建立新專案時參考。"
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "取得使用者列表",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
